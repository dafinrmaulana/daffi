// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  username        String    @unique
  email           String    @unique
  password        String?
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  sessions        Session[]

  @@map("users")
}

model Session {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique @map("token_hash")
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginThrottle {
  id              Int       @id @default(autoincrement())
  keyHash         String    @unique @map("key_hash")
  failureCount    Int       @default(0) @map("failure_count")
  windowStartedAt DateTime  @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("login_throttles")
}

model Project {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  company   Company  @relation(fields: [companyId], references: [id])
  role      String
  year      Int
  demoUrl   String?  @map("demo_url")
  thumbnail String
  metric    String?
  excerpt   String
  featured  Boolean  @default(false)
  tags      Tag[]
  body      String   @db.Text
  metrics   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  companyId Int      @map("company_id")

  @@map("projects")
}

model Post {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  date      DateTime
  readTime  Int?     @map("read_time")
  thumbnail String
  excerpt   String
  published Boolean  @default(false)
  tags      Tag[]
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("posts")
}

model Experience {
  id                 Int               @id @default(autoincrement())
  companyId          Int               @map("company_id")
  company            Company           @relation(fields: [companyId], references: [id])
  role               String
  slug               String            @unique
  startDate          DateTime          @map("start_date")
  endDate            DateTime?         @map("end_date")
  location           String
  description        String            @db.Text
  projectHighlightId Int?              @map("project_highlight_id")
  projectHighlight   ProjectHighlight? @relation(fields: [projectHighlightId], references: [id])
  skills             Skill[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@map("experiences")
}

model Skill {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String       @unique
  description String?
  experiences Experience[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("skills")
}

model Tag {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  posts       Post[]
  projects    Project[]

  @@map("tags")
}

model ProjectHighlight {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String       @unique
  description String?
  experiences Experience[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("project_highlights")
}

model Company {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  description String?
  companyLogo String?      @map("company_logo")
  projects    Project[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  experiences Experience[]

  @@map("companies")
}
